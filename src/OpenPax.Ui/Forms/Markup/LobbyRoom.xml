<!-- A room before its game (mode 4): the members, each one's choices, the host's galaxy, the room's chat. -->
<Form xmlns="https://openpax.local/forms" xmlns:x="https://openpax.local/forms/x">
  <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="8">
    <Border Grid.Row="0" Look="Strip" Height="20">
      <TextBlock Text="{Binding Title}" Look="Heading" Bold="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
      <GroupBox Grid.Column="0" Header="PLAYERS">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,6,0,0">
            <CheckBox x:Name="Ready" Text="I am ready" IsChecked="{Binding Ready}" Visibility="{Binding MemberOnly}" />
            <TextBlock Text="{Binding Status}" TextWrapping="True" />
          </StackPanel>
          <ListBox x:Name="Members" ItemsSource="{Binding Members}" />
        </DockPanel>
      </GroupBox>
      <StackPanel Grid.Column="1" Spacing="8">
        <GroupBox Header="YOU PLAY AS">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
            <TextBlock Grid.Row="0" Text="Species" Look="Dim" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="Species" ItemsSource="{Binding Species}" SelectedIndex="{Binding SpeciesIndex}" />
            <TextBlock Grid.Row="1" Text="Flag" Look="Dim" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <NumericUpDown x:Name="Flag" Minimum="1" Maximum="30" Value="{Binding Flag}" VerticalAlignment="Center" />
              <Image Source="{Binding FlagImage}" />
            </StackPanel>
            <TextBlock Grid.Row="2" Text="Fleet" Look="Dim" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <NumericUpDown x:Name="Color" Minimum="1" Maximum="16" Value="{Binding Color}" VerticalAlignment="Center" />
              <Image Source="{Binding ShipSmall}" VerticalAlignment="Center" />
              <Image Source="{Binding ShipMedium}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </GroupBox>
        <GroupBox Header="GALAXY">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Grid.Row="0" Text="Stars" Look="Dim" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="Stars" Minimum="20" Maximum="100" Step="5" Value="{Binding Stars}" IsEnabled="{Binding IsHost}" />
            <TextBlock Grid.Row="1" Text="Computer opponents" Look="Dim" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="Opponents" Minimum="0" Maximum="8" Value="{Binding Opponents}" IsEnabled="{Binding IsHost}" />
            <TextBlock Grid.Row="2" Text="Difficulty" Look="Dim" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="Difficulty" Minimum="1" Maximum="5" Value="{Binding Difficulty}" IsEnabled="{Binding IsHost}" />
          </Grid>
        </GroupBox>
        <GroupBox Header="MODS">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding HostOnly}">
                <Button x:Name="ToggleMod" Text="ON / OFF" Width="70" Click="OnModToggle" />
                <Button x:Name="ModUp" Text="UP" Width="44" Click="OnModUp" />
                <Button x:Name="ModDown" Text="DOWN" Width="56" Click="OnModDown" />
              </StackPanel>
              <TextBlock Text="{Binding ModStatus}" Look="Dim" TextWrapping="True" />
            </StackPanel>
            <ListBox x:Name="Mods" ItemsSource="{Binding Mods}" SelectedIndex="{Binding ModIndex}" Height="70" />
          </DockPanel>
        </GroupBox>
      </StackPanel>
      <GroupBox Grid.Column="2" Header="ROOM CHAT">
        <DockPanel>
          <TextBox DockPanel.Dock="Bottom" x:Name="Say" Text="{Binding Say}" Placeholder="Say something, then Return" Submitted="OnSay" Margin="0,6,0,0" />
          <ListBox x:Name="Chat" ItemsSource="{Binding Chat}" FollowLast="True" />
        </DockPanel>
      </GroupBox>
    </Grid>
    <DockPanel Grid.Row="2" LastChildFill="False">
      <Button DockPanel.Dock="Left" x:Name="Leave" Text="LEAVE" Width="122" Click="OnLeave" />
      <Button DockPanel.Dock="Right" x:Name="Start" Text="START" Width="122" Click="OnStart" IsEnabled="{Binding CanStart}" Visibility="{Binding HostOnly}" />
    </DockPanel>
  </Grid>
</Form>
